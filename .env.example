# H2 Assistente — nunca exponha estas variáveis no frontend, PWA ou APK.
# Configure os valores reais somente no ambiente seguro do servidor.

# Provider principal de IA, transcrição e resposta por voz
OPENAI_API_KEY=
# Opcional: modelo de texto/orquestração. O servidor usa um fallback seguro se não definido.
H2_ASSISTANT_OPENAI_MODEL=gpt-4.1-mini
# Opcional: modelo de transcrição de voz.
H2_ASSISTANT_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Opcional: modelo de resposta falada.
H2_ASSISTANT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Opcional: voz da resposta falada.
H2_ASSISTANT_OPENAI_TTS_VOICE=alloy

# Limites de proteção do servidor. Os limites individuais também ficam persistidos por usuário.
H2_ASSISTANT_MAX_REQUESTS_PER_MINUTE=12
H2_ASSISTANT_MAX_AUDIO_SECONDS_PER_REQUEST=90
H2_ASSISTANT_MAX_TEXT_CHARACTERS=2000

# Backup completo do Walk Ajuda. Gere uma chave hexadecimal de 32 bytes fora do GitHub.
# Sem esta chave o backup não é criado; nunca a coloque no repositório.
BACKUP_ENCRYPTION_KEY=
# Opcional: commit/versão exibido no inventário do backup.
RENDER_GIT_COMMIT=
# Dumpling oficial já é instalado no Dockerfile; use o caminho padrão salvo no container.
BACKUP_DUMPLING_BINARY=/usr/local/bin/dumpling
# Para DATABASE_URL com TLS, pode informar uma CA customizada montada no Render.
# Se ficar vazio, o backup usa o trust store do container: /etc/ssl/certs/ca-certificates.crt.
# Certificado e chave de cliente são opcionais para TLS de mão única; se usados, configure ambos em par.
BACKUP_DUMPLING_CA_PATH=
BACKUP_DUMPLING_CERT_PATH=
BACKUP_DUMPLING_KEY_PATH=
# Google Drive opcional: use OAuth de uma conta/pasta privada dedicada.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Restore somente em ambiente isolado; nunca usar os destinos de produção.
RESTORE_MODE=
RESTORE_CONFIRM=
RESTORE_TARGET_LABEL=
RESTORE_DATABASE_URL=
RESTORE_MYSQL_CLIENT=mysql
RESTORE_R2_ENDPOINT=
RESTORE_R2_ACCESS_KEY_ID=
RESTORE_R2_SECRET_ACCESS_KEY=
RESTORE_R2_BUCKET_NAME=
RESTORE_R2_PREFIX=
RESTORE_EXACT_ROW_COUNTS=0
RESTORE_ALLOW_INSECURE_LOCAL_R2=0

# Futuro provider opcional. Não é usado na primeira versão.
ELEVENLABS_API_KEY=
