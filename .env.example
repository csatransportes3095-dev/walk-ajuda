# H2 Assistente — nunca exponha estas variáveis no frontend, PWA ou APK.
# Configure os valores reais somente no ambiente seguro do servidor.

# Provider principal de IA, transcrição e resposta por voz
OPENAI_API_KEY=
# Opcional: modelo de texto/orquestração. O servidor usa um fallback seguro se não definido.
H2_ASSISTANT_OPENAI_MODEL=gpt-4.1-mini
# Opcional: modelo de transcrição de voz.
H2_ASSISTANT_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Opcional: modelo de resposta falada.
H2_ASSISTANT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Opcional: voz da resposta falada.
H2_ASSISTANT_OPENAI_TTS_VOICE=alloy

# Limites de proteção do servidor. Os limites individuais também ficam persistidos por usuário.
H2_ASSISTANT_MAX_REQUESTS_PER_MINUTE=12
H2_ASSISTANT_MAX_AUDIO_SECONDS_PER_REQUEST=90
H2_ASSISTANT_MAX_TEXT_CHARACTERS=2000

# Futuro provider opcional. Não é usado na primeira versão.
ELEVENLABS_API_KEY=
